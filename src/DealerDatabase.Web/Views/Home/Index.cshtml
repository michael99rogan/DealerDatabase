@model IReadOnlyList<DealerDatabase.Data.Entities.Dealer>
@{
    ViewData["Title"] = "Dealers";
}

<h1 class="h3 mb-3">Dealers</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No dealers found. Run the import console application to populate the database.</p>
}
else
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Legal name</th>
                <th>Company no.</th>
                <th>FCA FRN</th>
                <th>VAT no.</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dealer in Model)
            {
                <tr>
                    <td>@(dealer.DisplayName ?? "(Unnamed dealer)")</td>
                    <td>@dealer.LegalName</td>
                    <td>@dealer.CompanyNumber</td>
                    <td>@dealer.FcaFrn</td>
                    <td>@dealer.VatNumber</td>
                </tr>
            }
        </tbody>
    </table>
}
